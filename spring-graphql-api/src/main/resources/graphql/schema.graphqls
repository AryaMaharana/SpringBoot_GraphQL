type Author{
    authorId: ID!
    authorName: String
    books: [Book]

}
type Book {
    bookId: ID!
    bookName: String
    price: Int
    author: Author
}

input CreateBookRequest {
    bookId: ID
    bookName: String
    price: Int
    authorId: ID
}

type Query {
    getBookByBookId(bookId: ID!): Book
    getAllBooks: [Book]
    getBookByAuthorId(authorId: ID): [Book]
}

type Mutation {
    addBooks(input: CreateBookRequest): Book
}